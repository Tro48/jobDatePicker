node_modules/
.expo/
dist/
web-build/
*.log
.DS_Store
# Только каталоги prebuild в корне. Без ведущего слэша правило съедало
# android-часть локального нативного модуля, и в сборку она бы не уехала.
/android/
/ios/
.env*.local
expo-env.d.ts

# Проектная документация — рабочие заметки, а не часть выпуска.
# Звёздочка, а не «docs/»: исключённый каталог нельзя приоткрыть обратно, и
# правило «!docs/privacy.md» при «docs/» просто не сработало бы.
docs/*

# Политика конфиденциальности — исключение: её отдаёт GitHub Pages, и адрес
# страницы указан и в карточке приложения, и в самом приложении. Вместе с ней
# едет и то, из чего Pages собирает сайт: настройки, макет и главная страница.
!docs/privacy.md
!docs/index.md
!docs/_config.yml
!docs/_layouts/

# Сборочный мусор нативных модулей. Правило /android/ выше их не ловит: оно
# нарочно привязано к корню, чтобы не съесть исходники самих модулей.
modules/*/android/build/
