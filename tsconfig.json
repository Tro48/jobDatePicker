{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": false,
    /* Доменный слой импортирует соседей с расширением .ts — этого требует
       запуск тестов в голом Node через --experimental-strip-types. */
    "allowImportingTsExtensions": true,
    /* Тесты доменного слоя бегут в Node и импортируют node:test и node:assert.
       Без явного types их не видит moduleResolution: bundler из базы Expo. */
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
